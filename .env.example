MATTERPORT_TOKEN_ID=
MATTERPORT_TOKEN_SECRET=
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=
# iMessage via Photon Spectrum (photon/ bridge). Project id + secret from app.photon.codes project settings.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# E.164 numbers the bridge may text and accept texts from (each must be a project user on the free plan)
PHOTON_OWNER_PHONE=
PHOTON_TEAM_PHONE=
# shared secret between app/photon.py and the bridge (any long random string)
PHOTON_BRIDGE_TOKEN=
PHOTON_BRIDGE_PORT=8787
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=production
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=true
RADAR_SPEC_MODEL=gemini-3.8-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
RADAR_FIELD_TOKEN=
RADAR_SCENE_MODE=ack
RADAR_MATTERPORT=auto
RADAR_ORCH_MODEL=gemini-3.8-flash
RADAR_WORKER_MODEL=gemini-4-argon
# Live graph latency (app/agent.py models()). Live specialists run on RADAR_FAST_MODEL; RADAR_SPEC_MODEL is now
# their fallback and the worker's specialists. Every live model call gets one attempt of RADAR_MODEL_TIMEOUT_S
# (0 = no limit), then the same request on the other model, then a last try with no limit. The worker has none.
# RADAR_FAST_MODEL=gemini-3.5-flash-lite
# RADAR_FAST_THINKING=minimal   (gemini-3.8-flash rejects "minimal"; use "low" if you point RADAR_FAST_MODEL at it)
# RADAR_MODEL_TIMEOUT_S=8
# RADAR_MODEL_RETRIES=0         (extra same-model tries before switching; a retry usually lands in the same stall)
# scripts/run_agent.py always runs scene verbs in dispatch mode (no browser); RADAR_SCENE_MODE_RUN=ack overrides.
VEXCEL_API_KEY=
MATTERPORT_TEAM_TOKEN_ID=
MATTERPORT_TEAM_TOKEN_SECRET=
MATTERPORT_SDK_KEY=
MATTERPORT_HP_BASE=https://beta-app.matterport.com/2026-princeton-hackathon
MATTERPORT_HP_TOKEN=
# Data layers (app/layers.py): auto = synthetic TEST-* fixture if present, else CoStar kit / live Vexcel (cached)
RADAR_LAYER_COSTAR=auto
RADAR_LAYER_VEXCEL=auto
COSTAR_KIT_DIR=
# NREL PVWatts key (free at developer.nlr.gov) for scripts/solar_screen.py --refresh-yield
NLR_API_KEY=
